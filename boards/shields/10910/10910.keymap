#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_bspc {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp BACKSPACE>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp DELETE>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <17 19>;
            bindings = <&kp RETURN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O           &kp P
                &kp A        &kp S        &kp D        &kp F        &kp G        &kp H        &kp J        &kp K        &none           &kp L
                &hm LSHFT Z  &kp X        &hm LCTRL C  &hm LALT V   &hm LGUI B   &lt 1 SPACE  &lt 2 N      &hm RGUI M   &hm RCTRL COMMA &hm RSHFT DOT
            >;
        };

        mod1_layer {
            bindings = <
                &kp GRAVE  &bt BT_CLR_ALL  &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
                &kp PIPE   &kp C_NEXT      &kp C_PLAY    &none  &none  &kp MINUS     &kp EQUAL     &kp LBRC  &none      &kp RBRC
                &kp LSHFT  &kp C_VOL_DN    &kp C_VOL_UP  &none  &none  &none         &kp SEMI      &kp SQT   &kp SLASH  &kp RSHFT
            >;
        };

        mod2_layer {
            bindings = <
                &kp N1     &kp N2           &kp N3           &kp N4           &kp N5  &kp N6     &kp N7     &kp N8     &kp N9      &kp N0
                &kp BSLH   &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &none   &kp MINUS  &kp EQUAL  &kp LBRC   &none       &kp RBRC
                &kp LSHFT  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &none   &none      &none      &none      &none       &kp RSHFT
            >;
        };
    };
};
